# Copiar a .env para desarrollo local (los defaults ya apuntan al Postgres de docker-compose).
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agrobot
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agrobot_test
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Timeouts por conexión de Postgres en ms (0 = sin límite; docs/API.md §Convenciones).
# Un lock_timeout/statement_timeout vencido responde 503 y el cliente puede reintentar.
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000

# Tope de alertas vivas por campo (docs/API.md §alerts)
MAX_ALERTS_PER_FIELD=10

# Cuota de campos por usuario (docs/API.md §fields)
MAX_FIELDS_PER_USER=20

# Tamaño máximo del body de un request en bytes (docs/API.md §Convenciones)
MAX_REQUEST_BODY_BYTES=65536

# Frescura máxima de un pronóstico para evaluarlo (docs/JOBS.md §Evaluador)
MAX_FORECAST_AGE_HOURS=24

# Horizonte de evaluación desde el "hoy" local de cada campo (0 = sin límite)
ALERT_HORIZON_DAYS=7

# Margen de histéresis del re-aviso por episodio (docs/JOBS.md §Episodios)
REARM_MARGIN=10

# Tolerancia de reloj para un issued_at en el futuro (docs/JOBS.md §Ingesta mock)
FORECAST_FUTURE_TOLERANCE_MINUTES=60

# Vigencia de las respuestas guardadas con `Idempotency-Key` (docs/API.md §Idempotency-Key)
IDEMPOTENCY_TTL_HOURS=24

# Background job (evaluación + despacho)
WORKER_INTERVAL_SECONDS=60
DISPATCH_BATCH_SIZE=100
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_BACKOFF_BASE_SECONDS=30
NOTIFIER_TIMEOUT_SECONDS=10
DISPATCH_CONCURRENCY=10
DISPATCH_LEASE_SECONDS=120

# Tope de notificaciones por mensaje en el envío agrupado por usuario (1..20)
DIGEST_MAX_ITEMS=10
